import { useEffect, useMemo, useRef, useState } from "react";
import {
  X, Search, Heart, Trash2, MapPin, CalendarDays, Users, Wallet, ArrowRight,
  MessageCircle, Eye, Compass, Mountain, Waves, Landmark, Gem, UsersRound, ChevronRight,
} from "lucide-react";
import { DESTINATIONS, TRAVEL_STYLES, formatPKR, getDestination, type GeneratedTrip } from "../data/travel";
import { useModalLifecycle, Stars } from "./ui";

/* ================= global search ================= */

export function SearchPalette({
  open, onClose, onSelectDestination, onSelectStyle,
}: {
  open: boolean;
  onClose: () => void;
  onSelectDestination: (id: string) => void;
  onSelectStyle: (id: string) => void;
}) {
  const [q, setQ] = useState("");
  const [cursor, setCursor] = useState(0);
  const inputRef = useRef<HTMLInputElement>(null);
  useModalLifecycle(open, onClose);

  useEffect(() => {
    if (open) { setQ(""); setCursor(0); setTimeout(() => inputRef.current?.focus(), 60); }
  }, [open ]);

  const results = useMemo(() => {
    const needle = q.trim().toLowerCase();
    const dests = DESTINATIONS.filter((d) => {
      if (!needle) return true;
      return [d.name, d.shortName, d.region, d.description, ...d.tags, ...d.category]
        .join(" ").toLowerCase().includes(needle);
    }).map((d) => ({ type: "destination" as const, id: d.id, title: d.name, sub: d.region, img: d.thumb, rating: d.rating }));
    const styles = TRAVEL_STYLES.filter((s) => {
      if (!needle) return false;
      return [s.title, s.description].join(" ").toLowerCase().includes(needle);
    }).map((s) => ({ type: "style" as const, id: s.id, title: s.title, sub: s.duration, img: s.image, rating: 0 }));
    return [...dests, ...styles].slice(0, 9);
  }, [q]);

  useEffect(() => setCursor(0), [q]);

  if (!open) return null;

  const pick = (r: (typeof results)[number]) => {
    if (r.type === "destination") onSelectDestination(r.id);
    else onSelectStyle(r.id);
    onClose();
  };

  return (
    <div className="fixed inset-0 z-[100] flex items-start justify-center px-4 pt-[10dvh] md:pt-[14dvh]" role="dialog" aria-modal="true" aria-label="Search destinations">
      <div className="modal-backdrop absolute inset-0" onClick={onClose} />
      <div className="modal-panel-center relative w-full max-w-xl overflow-hidden rounded-xl border border-ivory/15 bg-coal shadow-2xl">
        <div className="flex items-center gap-3 border-b border-ivory/10 px-5 py-4">
          <Search size={18} className="shrink-0 text-champagne" />
          <input
            ref={inputRef}
            value={q}
            onChange={(e) => setQ(e.target.value)}
            onKeyDown={(e) => {
              if (e.key === "ArrowDown") { e.preventDefault(); setCursor((c) => Math.min(results.length - 1, c + 1)); }
              if (e.key === "ArrowUp") { e.preventDefault(); setCursor((c) => Math.max(0, c - 1)); }
              if (e.key === "Enter" && results[cursor]) pick(results[cursor]);
            }}
            placeholder="Search mountains, valleys, heritage, coast…"
            className="w-full bg-transparent text-[15px] font-semibold text-ivory placeholder:text-ivory/35 focus:outline-none"
            aria-label="Search destinations and travel styles"
          />
          <kbd className="hidden rounded border border-ivory/15 px-1.5 py-0.5 text-[10px] font-bold text-ivory/40 md:block">ESC</kbd>
        </div>
        <div className="max-h-[52dvh] overflow-y-auto p-2">
          {results.length === 0 && (
            <p className="px-4 py-8 text-center text-[14px] text-ivory/50">
              No matches for “{q}”. Try “mountains”, “fort”, “beach” or “Kalash”.
            </p>
          )}
          {results.map((r, i) => (
            <button
              key={`${r.type}-${r.id}`}
              onClick={() => pick(r)}
              onMouseEnter={() => setCursor(i)}
              className={`flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left ${i === cursor ? "bg-ivory/8" : ""}`}
              style={i === cursor ? { background: "rgba(245,241,232,0.07)" } : undefined}
            >
              <img src={r.img} alt="" className="h-11 w-14 shrink-0 rounded object-cover" loading="lazy" />
              <span className="min-w-0 flex-1">
                <span className="block truncate text-[14px] font-bold text-ivory">{r.title}</span>
                <span className="block text-[12px] text-ivory/50">{r.type === "style" ? `Travel style · ${r.sub}` : r.sub}</span>
              </span>
              {r.rating > 0 ? <Stars rating={r.rating} /> : <ChevronRight size={16} className="text-ivory/40" />}
            </button>
          ))}
        </div>
        <div className="flex items-center gap-2 border-t border-ivory/10 px-5 py-3 text-[11.5px] font-semibold text-ivory/40">
          <Compass size={13} /> Try “lakes”, “desert”, “food”, “trekking” — ↑↓ to navigate, ↵ to open
        </div>
      </div>
    </div>
  );
}

/* ================= favorites drawer ================= */

export function FavoritesDrawer({
  open, onClose, favorites, onRemove, onPlan, onBrowse,
}: {
  open: boolean;
  onClose: () => void;
  favorites: Set<string>;
  onRemove: (id: string) => void;
  onPlan: (id: string) => void;
  onBrowse: () => void;
}) {
  useModalLifecycle(open, onClose);
  if (!open) return null;
  const list = [...favorites].map(getDestination);

  return (
    <div className="fixed inset-0 z-[92] flex justify-end" role="dialog" aria-modal="true" aria-label="Favorite destinations">
      <div className="modal-backdrop absolute inset-0" onClick={onClose} />
      <aside className="drawer-right relative flex h-full w-full max-w-md flex-col bg-coal sm:border-l sm:border-ivory/12">
        <div className="flex items-center justify-between border-b border-ivory/10 px-6 py-5">
          <div>
            <p className="eyebrow text-champagne">Saved for later</p>
            <h3 className="mt-1 font-display text-[26px] font-semibold text-ivory">Favorites {list.length > 0 && <span className="text-champagne tabular">({list.length})</span>}</h3>
          </div>
          <button onClick={onClose} aria-label="Close favorites" className="btn-press flex h-10 w-10 items-center justify-center rounded-full border border-ivory/15 text-ivory/70 hover:border-champagne">
            <X size={18} />
          </button>
        </div>
        <div className="flex-1 overflow-y-auto p-4">
          {list.length === 0 ? (
            <div className="flex h-full flex-col items-center justify-center px-8 text-center">
              <span className="flex h-16 w-16 items-center justify-center rounded-full border border-ivory/12 text-ivory/30">
                <Heart size={24} />
              </span>
              <h4 className="mt-5 font-display text-[24px] font-medium text-ivory">Nothing saved yet</h4>
              <p className="mt-2 text-[14px] leading-relaxed text-ivory/55">Tap the heart on any destination and it will wait for you here.</p>
              <button onClick={onBrowse} className="btn-press mt-6 inline-flex items-center gap-2 rounded-full bg-ivory px-6 py-3 text-[12.5px] font-extrabold uppercase tracking-[0.1em] text-ink hover:bg-champagne">
                Browse destinations <ArrowRight size={15} />
              </button>
            </div>
          ) : (
            <ul className="space-y-3">
              {list.map((d) => (
                <li key={d.id} className="overflow-hidden rounded-lg border border-ivory/12 bg-ink">
                  <div className="flex gap-3 p-3">
                    <img src={d.thumb} alt={d.name} className="h-20 w-24 shrink-0 rounded object-cover" loading="lazy" />
                    <div className="min-w-0 flex-1">
                      <p className="text-[10px] font-bold uppercase tracking-[0.22em] text-champagne">{d.region}</p>
                      <p className="truncate font-display text-[19px] font-semibold text-ivory">{d.name}</p>
                      <div className="mt-1 flex items-center gap-3">
                        <Stars rating={d.rating} />
                        <span className="text-[12.5px] font-bold text-ivory/60 tabular">from {formatPKR(d.startingPrice)}</span>
                      </div>
                    </div>
                  </div>
                  <div className="flex gap-2 border-t border-ivory/10 p-3">
                    <button onClick={() => onPlan(d.id)} className="btn-press flex-1 rounded-full bg-champagne py-2.5 text-[12px] font-extrabold uppercase tracking-[0.1em] text-ink hover:bg-champagnelight">
                      Plan trip
                    </button>
                    <button onClick={() => onRemove(d.id)} aria-label={`Remove ${d.name}`}
                      className="btn-press flex h-10 w-10 items-center justify-center rounded-full border border-ivory/15 text-ivory/60 hover:border-copper hover:text-copper">
                      <Trash2 size={15} />
                    </button>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
      </aside>
    </div>
  );
}

/* ================= saved trips drawer ================= */

