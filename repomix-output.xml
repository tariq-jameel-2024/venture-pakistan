                    <select value={qp.budget} onChange={(e) => setQp({ ...qp, budget: e.target.value })}
                      className="mt-1.5 w-full bg-transparent text-[14.5px] font-bold text-ivory focus:outline-none" aria-label="Budget">
                      {["Economy", "Comfort", "Premium", "Luxury"].map((b) => <option key={b} value={b} className="bg-coal">{b}</option>)}
                    </select>
                  </label>
                  <button type="submit"
                    className="btn-press col-span-2 flex items-center justify-center gap-2 bg-champagne px-6 py-4 text-[13px] font-extrabold uppercase tracking-[0.12em] text-ink hover:bg-champagnelight md:col-span-1 md:py-0">
                    Build my trip <ArrowRight size={16} />
                  </button>
                </div>
              </form>
            </Reveal>
          </div>
        </section>

        {/* ================= TRUST BAR ================= */}
        <section className="border-y border-ivory/10 bg-coal" aria-label="Why travel with us">
          <div className="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-ivory/10 px-0 md:grid-cols-4">
