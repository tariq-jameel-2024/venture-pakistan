<file path="src/components/Planner.tsx">
import { useEffect, useMemo, useState } from "react";
import {
  X, Sparkles, MapPin, CalendarDays, Users, Wallet, Gauge, Minus, Plus,
  ChevronDown, Check, ArrowRight, Printer, Share2, MessageCircle, Bookmark,
  Compass, Camera, Mountain, UtensilsCrossed, Landmark, ShoppingBag, Tent,
  Clock, FileText, Lightbulb, Backpack, Sun, CircleAlert,
} from "lucide-react";
import {
  DESTINATIONS, LOADING_MESSAGES, formatPKR, generateItinerary,
  type GeneratedTrip, type PlannerInput,
} from "../data/travel";
import { SectionHeading, Reveal, useModalLifecycle } from "./ui";

const TRAVEL_STYLE_OPTS = ["Adventure", "Culture", "Relaxation", "Luxury", "Family", "Photography"];
const PACE_OPTS: Array<"Relaxed" | "Balanced" | "Packed"> = ["Relaxed", "Balanced", "Packed"];
const INTEREST_OPTS = [
  { id: "Mountains", icon: Mountain }, { id: "Food", icon: UtensilsCrossed },
  { id: "Photography", icon: Camera }, { id: "History", icon: Landmark },
  { id: "Nature", icon: Tent }, { id: "Shopping", icon: ShoppingBag }, { id: "Adventure", icon: Compass },
];
const BUDGET_OPTS: Array<PlannerInput["budget"]> = ["Economy", "Comfort", "Premium", "Luxury"];

/* ================= planner modal ================= */

export function PlannerModal({
  open, onClose, presetDestination, onGenerated, travelersDefault = 2, daysDefault = 5, budgetDefault = "Comfort",
}: {
  open: boolean;
  onClose: () => void;
  presetDestination: string;
  onGenerated: (trip: GeneratedTrip) => void;
  travelersDefault?: number;
  daysDefault?: number;
  budgetDefault?: PlannerInput["budget"];
}) {
  const [destinationId, setDestinationId] = useState(presetDestination);
  const [days, setDays] = useState(daysDefault);
  const [travelers, setTravelers] = useState(travelersDefault);
  const [budget, setBudget] = useState<PlannerInput["budget"]>(budgetDefault);
  const [travelStyle, setTravelStyle] = useState("Adventure");
  const [pace, setPace] = useState<PlannerInput["pace"]>("Balanced");
  const [interests, setInterests] = useState<string[]>(["Mountains", "Photography"]);
  const [generating, setGenerating] = useState(false);
  const [loadMsg, setLoadMsg] = useState(0);
  const [error, setError] = useState("");

  useModalLifecycle(open, () => { if (!generating) onClose(); });
  useEffect(() => {
    if (open) {
      setDestinationId(presetDestination);
      setDays(daysDefault);
      setTravelers(travelersDefault);
      setBudget(budgetDefault);
      setError("");
    }
  }, [open, presetDestination, daysDefault, travelersDefault, budgetDefault]);

  useEffect(() => {
    if (!generating) return;
    const iv = setInterval(() => setLoadMsg((m) => (m + 1) % LOADING_MESSAGES.length), 900);
    return () => clearInterval(iv);
  }, [generating]);

  const toggleInterest = (id: string) =>
    setInterests((prev) => (prev.includes(id) ? prev.filter((i) => i !== id) : [...prev, id]));

  const estimated = useMemo(() => {
    const perDay: Record<string, number> = { Economy: 14000, Comfort: 22000, Premium: 34000, Luxury: 55000 };
    return Math.round((perDay[budget] * days * (1 + (travelers - 1) * 0.55)) / 1000) * 1000;
  }, [budget, days, travelers]);

  const handleGenerate = () => {
    if (!destinationId) { setError("Please select a destination first."); return; }
    if (interests.length === 0) { setError("Pick at least one interest so we can shape your days."); return; }
    setError("");
    setGenerating(true);
    // Demo-mode local generation (async feel). Swap with AI_CONFIG.endpoint later.
    setTimeout(() => {
      const trip = generateItinerary({ destinationId, days, travelers, budget, travelStyle, pace, interests });
      setGenerating(false);
      onGenerated(trip);
    }, 3400);
  };

  if (!open) return null;

  return (
    <div className="fixed inset-0 z-[90] flex items-end justify-center md:items-center md:p-6" role="dialog" aria-modal="true" aria-label="Trip planner">
      <div className="modal-backdrop absolute inset-0" onClick={() => { if (!generating) onClose(); }} />
      <div className="modal-panel relative flex max-h-[94dvh] w-full flex-col overflow-hidden rounded-t-2xl border border-ivory/12 bg-coal md:max-w-3xl md:rounded-xl">
        {/* header */}
        <div className="flex items-center justify-between border-b border-ivory/10 px-5 py-4 md:px-8">
          <div className="flex items-center gap-3">
            <span className="flex h-9 w-9 items-center justify-center rounded-full bg-champagne/15 text-champagne">
              <Sparkles size={17} />
            </span>
            <div>
              <p className="eyebrow text-champagne">AI Trip Planner</p>
              <h3 className="font-display text-[22px] font-semibold leading-tight text-ivory">Your Trip, Your Rules.</h3>
            </div>
          </div>
          <button onClick={() => { if (!generating) onClose(); }} aria-label="Close planner"
            className="btn-press flex h-10 w-10 items-center justify-center rounded-full border border-ivory/15 text-ivory/70 hover:border-champagne hover:text-ivory">
            <X size={18} />
          </button>
        </div>

        {generating ? (
          <div className="flex flex-col items-center justify-center px-6 py-16 text-center">
            <div className="relative flex h-20 w-20 items-center justify-center">
              <span className="absolute inset-0 rounded-full border border-champagne/30" style={{ animation: "compassSpin 6s linear infinite" }}>
                <span className="absolute -top-1 left-1/2 h-2 w-2 -translate-x-1/2 rounded-full bg-champagne" />
              </span>
              <Compass size={30} className="text-champagne" />
            </div>
            <h4 className="mt-6 font-display text-[28px] font-medium text-ivory">Curating your journey…</h4>
            <p className="mt-2 flex items-center gap-2 text-[14px] font-semibold text-ivory/60" aria-live="polite">
              {LOADING_MESSAGES[loadMsg]}
              <span className="flex gap-1">
                {[0, 1, 2].map((i) => (
                  <span key={i} className="typing-dot h-1.5 w-1.5 rounded-full bg-champagne" style={{ animationDelay: `${i * 0.2}s` }} />
                ))}
              </span>
            </p>
            <div className="mt-8 w-full max-w-sm space-y-2.5">
              {[92, 74, 85].map((w, i) => (
                <div key={i} className="h-2 overflow-hidden rounded-full bg-ivory/8">
                  <div className="shimmer-line h-full rounded-full" style={{ width: `${w}%`, animationDelay: `${i * 0.3}s` }} />
                </div>
              ))}
            </div>
            <p className="mt-6 max-w-xs text-[12px] leading-relaxed text-ivory/35">
              Demo mode — itineraries are composed locally. A live AI concierge can be connected via API later.
            </p>
          </div>
        ) : (
          <>
            <div className="flex-1 overflow-y-auto px-5 py-6 md:px-8">
              {/* destination */}
              <label className="text-[11px] font-extrabold uppercase tracking-[0.22em] text-ivory/50" htmlFor="pl-dest">
                <MapPin size={12} className="mr-1.5 inline text-champagne" /> Destination
              </label>
              <div className="relative mt-2">
                <select
                  id="pl-dest"
                  value={destinationId}
                  onChange={(e) => setDestinationId(e.target.value)}
                  className="w-full appearance-none rounded-lg border border-ivory/15 bg-ink px-4 py-3.5 text-[15px] font-semibold text-ivory focus:border-champagne"
                >
                  {DESTINATIONS.map((d) => (
                    <option key={d.id} value={d.id}>{d.name} — {d.region}</option>
                  ))}
                </select>
                <ChevronDown size={17} className="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-ivory/50" />
              </div>

              {/* days + travelers */}
              <div className="mt-6 grid gap-4 sm:grid-cols-2">
                <div className="rounded-lg border border-ivory/12 bg-ink/60 p-4">
                  <p className="flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[0.22em] text-ivory/50">
                    <CalendarDays size={13} className="text-champagne" /> Days · 1–14
                  </p>
                  <div className="mt-3 flex items-center justify-between">
                    <button onClick={() => setDays((d) => Math.max(1, d - 1))} aria-label="Fewer days"
                      className="btn-press flex h-11 w-11 items-center justify-center rounded-full border border-ivory/15 hover:border-champagne"><Minus size={16} /></button>
                    <span className="font-display text-[34px] font-semibold text-ivory tabular">{days}</span>
                    <button onClick={() => setDays((d) => Math.min(14, d + 1))} aria-label="More days"
                      className="btn-press flex h-11 w-11 items-center justify-center rounded-full border border-ivory/15 hover:border-champagne"><Plus size={16} /></button>
                  </div>
                  <input type="range" min={1} max={14} value={days} onChange={(e) => setDays(+e.target.value)}
                    aria-label="Trip duration in days" className="mt-3 w-full accent-[#C9A86A]" />
                </div>
                <div className="rounded-lg border border-ivory/12 bg-ink/60 p-4">
                  <p className="flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[0.22em] text-ivory/50">
                    <Users size={13} className="text-champagne" /> Travelers · 1–10+
                  </p>
                  <div className="mt-3 flex items-center justify-between">
                    <button onClick={() => setTravelers((t) => Math.max(1, t - 1))} aria-label="Fewer travelers"
                      className="btn-press flex h-11 w-11 items-center justify-center rounded-full border border-ivory/15 hover:border-champagne"><Minus size={16} /></button>
                    <span className="font-display text-[34px] font-semibold text-ivory tabular">{travelers >= 10 ? "10+" : travelers}</span>
                    <button onClick={() => setTravelers((t) => Math.min(12, t + 1))} aria-label="More travelers"
                      className="btn-press flex h-11 w-11 items-center justify-center rounded-full border border-ivory/15 hover:border-champagne"><Plus size={16} /></button>
                  </div>
                  <p className="mt-3 text-[12px] text-ivory/45">Groups of 10+ get custom transport & rates.</p>
                </div>
              </div>

              {/* budget */}
              <p className="mt-6 flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[0.22em] text-ivory/50">
                <Wallet size={13} className="text-champagne" /> Budget tier
              </p>
              <div className="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-4">
                {BUDGET_OPTS.map((b) => (
                  <button key={b} onClick={() => setBudget(b)} aria-pressed={budget === b}
                    className={`btn-press rounded-lg border px-3 py-3 text-[13.5px] font-bold ${budget === b ? "border-champagne bg-champagne text-ink" : "border-ivory/15 text-ivory/70 hover:border-champagne/50"}`}>
                    {b}
                  </button>
                ))}
              </div>

              {/* style */}
              <p className="mt-6 text-[11px] font-extrabold uppercase tracking-[0.22em] text-ivory/50">Travel style</p>
              <div className="no-scrollbar mt-2 flex gap-2 overflow-x-auto pb-1">
                {TRAVEL_STYLE_OPTS.map((s) => (
                  <button key={s} onClick={() => setTravelStyle(s)} aria-pressed={travelStyle === s}
                    className={`btn-press shrink-0 rounded-full border px-4 py-2.5 text-[13px] font-bold ${travelStyle === s ? "border-champagne bg-champagne/15 text-champagne" : "border-ivory/15 text-ivory/70"}`}>
                    {s}
                  </button>
                ))}
              </div>

              {/* pace */}
              <p className="mt-5 flex items-center gap-2 text-[11px] font-extrabold uppercase tracking-[0.22em] text-ivory/50">
                <Gauge size={13} className="text-champagne" /> Travel pace
              </p>
              <div className="mt-2 grid grid-cols-3 gap-2">
                {PACE_OPTS.map((p) => (
                  <button key={p} onClick={() => setPace(p)} aria-pressed={pace === p}
                    className={`btn-press rounded-lg border px-3 py-3 text-[13px] font-bold ${pace === p ? "border-teal bg-teal/20 text-ivory" : "border-ivory/15 text-ivory/70"}`}>
                    {p}
                    <span className="mt-0.5 block text-[10.5px] font-semibold opacity-60">
                      {p === "Relaxed" ? "2 stops/day" : p === "Balanced" ? "3–4 stops" : "Dawn to dusk"}
                    </span>
                  </button>
                ))}
              </div>

              {/* interests */}
              <p className="mt-6 text-[11px] font-extrabold uppercase tracking-[0.22em] text-ivory/50">Interests</p>
              <div className="mt-2 flex flex-wrap gap-2">
                {INTEREST_OPTS.map(({ id, icon: Icon }) => {
                  const on = interests.includes(id);
                  return (
                    <button key={id} onClick={() => toggleInterest(id)} aria-pressed={on}
                      className={`btn-press inline-flex items-center gap-2 rounded-full border px-4 py-2.5 text-[13px] font-bold ${on ? "border-champagne bg-champagne text-ink" : "border-ivory/15 text-ivory/70"}`}>
                      <Icon size={14} /> {id} {on && <Check size={13} strokeWidth={3} />}
                    </button>
                  );
                })}
              </div>

              {error && (
                <p className="mt-5 flex items-center gap-2 rounded-lg border border-copper/40 bg-copper/10 px-4 py-3 text-[13.5px] font-semibold text-champagnelight" role="alert">
                  <CircleAlert size={16} /> {error}
                </p>
              )}
            </div>

            {/* footer */}
            <div className="border-t border-ivory/10 bg-ink/60 px-5 py-4 backdrop-blur-md md:px-8">
              <div className="flex items-center justify-between gap-4">
                <div>
                  <p className="text-[10px] font-bold uppercase tracking-[0.22em] text-ivory/40">Estimated from</p>
                  <p className="font-display text-[24px] font-semibold text-champagne tabular">{formatPKR(estimated)}</p>
                </div>
                <button onClick={handleGenerate}
                  className="btn-press inline-flex items-center gap-2 rounded-full bg-champagne px-6 py-3.5 text-[13px] font-extrabold uppercase tracking-[0.12em] text-ink hover:bg-champagnelight md:px-8">
                  <Sparkles size={16} /> Generate my journey
                </button>
              </div>
              <p className="mt-2 text-[11.5px] text-ivory/35">Estimated pricing may vary depending on season, availability and final booking selections.</p>
            </div>
          </>
        )}
      </div>
    </div>
  );
}

/* ================= itinerary view ================= */

export function ItineraryView({
  open, onClose, trip, onSave, saved, onBook,
}: {
  open: boolean;
  onClose: () => void;
  trip: GeneratedTrip | null;
  onSave: (t: GeneratedTrip) => void;
  saved: boolean;
  onBook: (t: GeneratedTrip) => void;
}) {
  const [openDays, setOpenDays] = useState<Set<number>>(new Set([1]));
  const [activeTab, setActiveTab] = useState<"plan" | "cost" | "notes">("plan");

  useModalLifecycle(open, onClose);
  useEffect(() => { if (open) { setOpenDays(new Set([1])); setActiveTab("plan"); } }, [open, trip?.id]);

  if (!open || !trip) return null;
  const toggleDay = (d: number) =>
    setOpenDays((prev) => { const n = new Set(prev); if (n.has(d)) n.delete(d); else n.add(d); return n; });

  const costRows = [
    { label: "Transport & driver", value: trip.costing.transport },
    { label: "Accommodation", value: trip.costing.accommodation },
    { label: "Activities & entry", value: trip.costing.activities },
    { label: "Food & dining", value: trip.costing.food },
    { label: "Local guide & support", value: trip.costing.guide },
  ];

  return (
    <div className="fixed inset-0 z-[95] flex items-end justify-center md:items-center md:p-6" role="dialog" aria-modal="true" aria-label={`Itinerary for ${trip.destination}`}>
      <div className="modal-backdrop absolute inset-0" onClick={onClose} />
      <div className="modal-panel relative flex max-h-[94dvh] w-full flex-col overflow-hidden rounded-t-2xl border border-ivory/12 bg-ink md:max-w-4xl md:rounded-xl">
        {/* document header */}
        <div className="relative shrink-0 overflow-hidden">
          <img src={DESTINATIONS.find((d) => d.id === trip.destinationId)?.image} alt="" aria-hidden="true" className="absolute inset-0 h-full w-full object-cover opacity-30" />
          <div className="absolute inset-0 bg-gradient-to-b from-ink/40 via-ink/70 to-ink" />
          <div className="relative flex items-start justify-between gap-4 px-5 pb-5 pt-5 md:px-8">
            <div>
              <p className="eyebrow text-champagne">Your travel document</p>
              <h3 className="mt-2 font-display text-[30px] font-medium leading-[1.05] text-ivory md:text-[38px]">
                {trip.destination}, <span className="italic text-champagne">your way.</span>
              </h3>
              <div className="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-[12.5px] font-semibold text-ivory/65">
                <span className="inline-flex items-center gap-1.5"><Clock size={13} className="text-champagne" /> {trip.duration} days</span>
                <span className="inline-flex items-center gap-1.5"><Users size={13} className="text-champagne" /> {trip.travelers} travelers</span>
                <span className="inline-flex items-center gap-1.5"><FileText size={13} className="text-champagne" /> {trip.travelStyle} · {trip.pace}</span>
                <span className="inline-flex items-center gap-1.5"><Wallet size={13} className="text-champagne" /> {trip.budget}</span>
              </div>
            </div>
            <button onClick={onClose} aria-label="Close itinerary"
              className="btn-press flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-ivory/20 bg-ink/60 text-ivory backdrop-blur-md hover:border-champagne">
              <X size={18} />
            </button>
          </div>
          {/* tabs */}
          <div className="relative flex gap-1 border-t border-ivory/10 bg-ink/70 px-5 backdrop-blur-md md:px-8" role="tablist" aria-label="Itinerary sections">
            {(["plan", "cost", "notes"] as const).map((t) => (
              <button key={t} role="tab" aria-selected={activeTab === t} onClick={() => setActiveTab(t)}
                className={`btn-press relative px-4 py-3.5 text-[12px] font-extrabold uppercase tracking-[0.16em] ${activeTab === t ? "text-champagne" : "text-ivory/45 hover:text-ivory"}`}>
                {t === "plan" ? "Day by day" : t === "cost" ? "Budget" : "Tariq's notes"}
                {activeTab === t && <span className="absolute inset-x-3 bottom-0 h-0.5 rounded-full bg-champagne" />}
              </button>
            ))}
          </div>
        </div>

        <div className="flex-1 overflow-y-auto px-5 py-6 md:px-8">
          {activeTab === "plan" && (
            <ol className="space-y-3">
              {trip.itinerary.map((d) => {
                const isOpen = openDays.has(d.day);
                return (
                  <li key={d.day} className="overflow-hidden rounded-lg border border-ivory/12 bg-coal">
                    <button onClick={() => toggleDay(d.day)} aria-expanded={isOpen}
                      className="flex w-full items-center gap-4 px-4 py-4 text-left md:px-5">
                      <span className="font-display text-[15px] font-bold tracking-[0.12em] text-champagne">
                        {String(d.day).padStart(2, "0")}
                      </span>
                      <span className="h-8 w-px bg-ivory/12" aria-hidden="true" />
                      <span className="flex-1">
                        <span className="block text-[10px] font-bold uppercase tracking-[0.24em] text-ivory/40">Day {String(d.day).padStart(2, "0")}</span>
