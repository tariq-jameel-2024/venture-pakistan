<file path="src/index.css">
@import "tailwindcss";

@theme {
  --color-ink: #0b0e14;
  --color-coal: #11151d;
  --color-ember: #171c25;
  --color-line: #202631;
  --color-ivory: #f5f1e8;
  --color-parchment: #eae5da;
  --color-sanddim: #a89e8d;
  --color-champagne: #c9a86a;
  --color-champagnelight: #e6cd9a;
  --color-teal: #5f8e8c;
  --color-tealdeep: #3d5f5e;
  --color-copper: #b0805a;
  --font-display: "Cormorant Garamond", "Playfair Display", Georgia, serif;
  --font-sans: "Manrope", "Inter", system-ui, sans-serif;
  --font-editorial: "Cormorant Garamond", Georgia, serif;
}

html {
  scroll-behavior: smooth;
}

body {
  background: #0b0e14;
  color: #f5f1e8;
  font-family: "Manrope", system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  overflow-x: hidden;
}

::selection {
  background: #c9a86a;
  color: #0b0e14;
}

/* ---------- scrollbar ---------- */
::-webkit-scrollbar { width: 10px; height: 8px; }
::-webkit-scrollbar-track { background: #0b0e14; }
::-webkit-scrollbar-thumb { background: #2a3140; border-radius: 8px; border: 2px solid #0b0e14; }
::-webkit-scrollbar-thumb:hover { background: #c9a86a; }

.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

/* ---------- focus ---------- */
:focus-visible {
  outline: 2px solid #c9a86a;
  outline-offset: 3px;
  border-radius: 2px;
}

/* ---------- type helpers ---------- */
.eyebrow {
  font-size: 11px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  font-weight: 700;
}
.display-italic { font-style: italic; }
.tabular { font-variant-numeric: tabular-nums; }

/* ---------- reveal on scroll ---------- */
.reveal {
  opacity: 0;
  transform: translateY(26px);
  transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1), transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  transition-delay: var(--reveal-delay, 0ms);
  will-change: opacity, transform;
}
.reveal.is-visible {
  opacity: 1;
  transform: none;
}
.reveal-scale {
  opacity: 0;
  transform: scale(0.97) translateY(14px);
  transition: opacity 1s cubic-bezier(0.22, 1, 0.36, 1), transform 1s cubic-bezier(0.22, 1, 0.36, 1);
  transition-delay: var(--reveal-delay, 0ms);
}
.reveal-scale.is-visible { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .reveal, .reveal-scale { opacity: 1 !important; transform: none !important; transition: none !important; }
  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}

/* ---------- image treatments ---------- */
.img-frame { overflow: hidden; position: relative; background: #171c25; }
.img-frame img { transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s ease; }
.img-frame:hover img { transform: scale(1.045); }
.img-duotone::after {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(to top, rgba(11,14,20,0.72) 0%, rgba(11,14,20,0.18) 45%, rgba(11,14,20,0.05) 100%);
}
.img-grain::before {
  content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0.5;
  background-image: radial-gradient(rgba(255,255,255,0.045) 1px, transparent 1px);
  background-size: 5px 5px;
}

/* ---------- hairlines ---------- */
.hairline { border-color: rgba(245, 241, 232, 0.09); }
.hairline-b { border-bottom: 1px solid rgba(245, 241, 232, 0.09); }

/* ---------- buttons ---------- */
.btn-press { transition: transform 0.15s ease, background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease; }
.btn-press:active { transform: scale(0.97); }

.link-underline {
  position: relative;
}
.link-underline::after {
  content: ""; position: absolute; left: 0; bottom: -4px; height: 1px; width: 0%;
  background: #c9a86a; transition: width 0.3s ease;
}
.link-underline:hover::after, .link-underline.active::after { width: 100%; }

/* ---------- modals / drawers ---------- */
.modal-backdrop {
  animation: fadeIn 0.28s ease both;
  background: rgba(5, 7, 11, 0.72);
  backdrop-filter: blur(6px);
}
.modal-panel {
  animation: sheetUp 0.38s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.modal-panel-center {
  animation: popIn 0.34s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.drawer-right {
  animation: slideRight 0.38s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheetUp { from { opacity: 0; transform: translateY(48px); } to { opacity: 1; transform: translateY(0); } }
@keyframes popIn { from { opacity: 0; transform: translateY(22px) scale(0.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes slideRight { from { opacity: 0; transform: translateX(60px); } to { opacity: 1; transform: translateX(0); } }

@media (max-width: 768px) {
  .modal-panel-center { animation: sheetUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both; }
}

/* ---------- toasts ---------- */
.toast-enter { animation: toastIn 0.35s cubic-bezier(0.22, 1, 0.36, 1) both; }
.toast-exit { animation: toastOut 0.3s ease both; }
@keyframes toastIn { from { opacity: 0; transform: translateY(16px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes toastOut { from { opacity: 1; } to { opacity: 0; transform: translateY(8px); } }

/* ---------- heart pop ---------- */
@keyframes heartPop { 0% { transform: scale(1); } 40% { transform: scale(1.35); } 100% { transform: scale(1); } }
.heart-pop { animation: heartPop 0.4s ease; }

/* ---------- map markers ---------- */
@keyframes markerPing {
  0% { transform: scale(1); opacity: 0.7; }
  80%, 100% { transform: scale(2.4); opacity: 0; }
}
.marker-ping { transform-origin: center; transform-box: fill-box; animation: markerPing 2.6s ease-out infinite; }
@keyframes dashFlow { to { stroke-dashoffset: -28; } }
.route-flow { stroke-dasharray: 5 7; animation: dashFlow 1.6s linear infinite; }

/* ---------- loading ---------- */
@keyframes loadBar { 0% { transform: translateX(-100%); } 100% { transform: translateX(250%); } }
@keyframes compassSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
@keyframes softPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }

/* ---------- AI generation shimmer ---------- */
@keyframes shimmerSlide { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
.shimmer-line {
  background: linear-gradient(90deg, rgba(201,168,106,0) 0%, rgba(201,168,106,0.35) 50%, rgba(201,168,106,0) 100%);
  background-size: 200% 100%;
  animation: shimmerSlide 1.8s ease-in-out infinite;
}
@keyframes dotPulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(0.6); opacity: 0.4; } }
.typing-dot { animation: dotPulse 1.2s ease-in-out infinite; }

/* ---------- marquee ---------- */
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
.marquee-track { animation: marquee 42s linear infinite; }
.marquee-track:hover { animation-play-state: paused; }

/* ---------- safe area ---------- */
.pb-env { padding-bottom: env(safe-area-inset-bottom, 0px); }
.pt-env { padding-top: env(safe-area-inset-top, 0px); }
.mb-env { margin-bottom: env(safe-area-inset-bottom, 0px); }

/* ---------- editorial details ---------- */
.vertical-text { writing-mode: vertical-rl; text-orientation: mixed; }
.drop-cap::first-letter {
  font-family: "Cormorant Garamond", serif;
  font-size: 3.4em;
  float: left;
  line-height: 0.85;
  padding-right: 0.12em;
  color: #c9a86a;
}
.thin-divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(201,168,106,0.5), transparent);
}
.chapter-number {
  font-family: "Cormorant Garamond", serif;
  -webkit-text-stroke: 1px rgba(201,168,106,0.35);
  color: transparent;
}

/* number input arrows off */
input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; }
