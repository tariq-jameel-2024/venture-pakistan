                  </label>
                  <label className="bg-ink/80 px-5 py-4">
                    <span className="flex items-center gap-1.5 text-[10px] font-extrabold uppercase tracking-[0.2em] text-champagne"><Clock size={11} /> Duration</span>
                    <select value={qp.duration} onChange={(e) => setQp({ ...qp, duration: e.target.value })}
                      className="mt-1.5 w-full bg-transparent text-[14.5px] font-bold text-ivory focus:outline-none" aria-label="Duration">
                      {["3", "4", "5", "6", "7", "10"].map((d) => <option key={d} value={d} className="bg-coal">{d} days</option>)}
                    </select>
                  </label>
                  <label className="bg-ink/80 px-5 py-4">
                    <span className="flex items-center gap-1.5 text-[10px] font-extrabold uppercase tracking-[0.2em] text-champagne"><Users size={11} /> Travelers</span>
                    <select value={qp.travelers} onChange={(e) => setQp({ ...qp, travelers: e.target.value })}
                      className="mt-1.5 w-full bg-transparent text-[14.5px] font-bold text-ivory focus:outline-none" aria-label="Travelers">
                      {["1", "2", "3", "4", "5", "6+"].map((t) => <option key={t} value={t} className="bg-coal">{t} {t === "1" ? "person" : "people"}</option>)}
