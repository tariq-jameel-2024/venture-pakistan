                      <Heart size={17} className={favorites.has("hunza") ? "fill-ink" : ""} />
                    </button>
                  </div>
                  <div className="p-5">
                    <p className="text-[11px] font-bold uppercase tracking-[0.3em] text-ivory/50">Hunza Valley</p>
