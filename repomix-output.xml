                <div className="grid grid-cols-2 gap-px bg-ivory/10 md:grid-cols-6">
                  <label className="bg-ink/80 px-5 py-4">
                    <span className="flex items-center gap-1.5 text-[10px] font-extrabold uppercase tracking-[0.2em] text-champagne"><MapPin size={11} /> Destination</span>
                    <select value={qp.dest} onChange={(e) => setQp({ ...qp, dest: e.target.value })}
                      className="mt-1.5 w-full bg-transparent text-[14.5px] font-bold text-ivory focus:outline-none" aria-label="Destination">
                      {DESTINATIONS.map((d) => <option key={d.id} value={d.id} className="bg-coal">{d.shortName}</option>)}
                    </select>
                  </label>
                  <label className="bg-ink/80 px-5 py-4">
                    <span className="flex items-center gap-1.5 text-[10px] font-extrabold uppercase tracking-[0.2em] text-champagne"><CalendarDays size={11} /> Dates</span>
                    <input type="month" value={qp.date} onChange={(e) => setQp({ ...qp, date: e.target.value })}
