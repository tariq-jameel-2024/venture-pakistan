            />
            <div className="absolute inset-0 bg-gradient-to-b from-ink/70 via-ink/35 to-ink" />
            <div className="absolute inset-0 bg-gradient-to-r from-ink/60 via-transparent to-transparent" />
          </div>

          <div className="relative mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-5 pb-10 pt-32 md:px-8 lg:pt-36">
            <div className="grid items-end gap-10 lg:grid-cols-[1.25fr_0.75fr]">
              <div>
                <Reveal>
                  <p className="eyebrow flex items-center gap-3 text-champagne">
                    <span className="inline-block h-px w-10 bg-champagne" aria-hidden="true" />
                    Travel Pakistan — Curated by Tariq
                  </p>
                </Reveal>
                <Reveal delay={90}>
                  <h1 className="mt-5 font-display text-[clamp(2.9rem,8vw,5.6rem)] font-medium leading-[0.98] text-ivory">
                    Pakistan,<br />
                    <span className="italic text-champagnelight">Beautifully</span> Unfiltered.
                  </h1>
                </Reveal>
                <Reveal delay={170}>
                  <p className="mt-5 max-w-lg text-[15.5px] leading-relaxed text-ivory/75 md:text-[17px]">
                    Discover mountains, valleys, heritage and coastlines through journeys designed around you — not around a bus schedule.
                  </p>
                </Reveal>
                <Reveal delay={240}>
                  <div className="mt-8 flex flex-col gap-3 sm:flex-row">
                    <button
                      onClick={() => openPlanner("hunza")}
                      className="btn-press inline-flex items-center justify-center gap-2 rounded-full bg-champagne px-8 py-4 text-[13px] font-extrabold uppercase tracking-[0.12em] text-ink hover:bg-champagnelight"
                    >
                      Plan my journey <ArrowRight size={16} />
                    </button>
                    <button
                      onClick={() => scrollTo("destinations")}
                      className="btn-press inline-flex items-center justify-center gap-2 rounded-full border border-ivory/30 px-8 py-4 text-[13px] font-extrabold uppercase tracking-[0.12em] text-ivory backdrop-blur-sm hover:border-ivory hover:bg-ivory/10"
                    >
                      Explore Pakistan
                    </button>
                  </div>
                </Reveal>
                <Reveal delay={300}>
                  <div className="mt-8 flex items-center gap-4 text-[12.5px] font-semibold text-ivory/60">
                    <span className="flex -space-x-2" aria-hidden="true">
                      {[IMAGES.kalash, IMAGES.attabad, IMAGES.lahoreFood].map((s, i) => (
                        <img key={i} src={s} alt="" className="h-8 w-8 rounded-full border-2 border-ink object-cover" loading="lazy" />
                      ))}
                    </span>
                    <span><b className="text-ivory">500+ travelers</b> guided since 2019 · ★ 4.9 average</span>
