  /* ================================================================ */
  return (
    <div id="top" className="min-h-screen bg-ink text-ivory">
      {/* ---------- loading screen ---------- */}
      {!booted && (
        <div className="fixed inset-0 z-[200] flex flex-col items-center justify-center bg-ink" role="status" aria-label="Loading Travel with Tariq">
          <LogoMark size={72} />
          <p className="mt-5 font-display text-[26px] font-medium text-ivory">
            Travel <span className="italic text-champagne">with</span> Tariq
          </p>
          <p className="eyebrow mt-2 text-ivory/40">See Pakistan Differently</p>
          <div className="mt-8 h-px w-48 overflow-hidden bg-ivory/10">
            <div className="h-full w-1/3 bg-champagne" style={{ animation: "loadBar 1.1s ease-in-out infinite" }} />
          </div>
        </div>
      )}

      <Navbar
        scrolled={scrolled}
        favCount={favorites.size}
        tripCount={trips.length}
        onSearch={() => setSearchOpen(true)}
        onFavorites={() => setFavOpen(true)}
        onTrips={() => setTripsOpen(true)}
        onTalk={() => talkToTariq()}
        onPlan={() => openPlanner("hunza")}
