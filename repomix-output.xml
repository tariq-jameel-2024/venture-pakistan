  Planning: "bg-ivory/10 text-ivory/70 border-ivory/15",
  "Ready to Book": "bg-champagne/15 text-champagne border-champagne/40",
  Confirmed: "bg-teal/15 text-teal border-teal/40",
};

export function TripsDrawer({
  open, onClose, trips, onView, onDelete, onBook, onStatus, onPlan,
}: {
  open: boolean;
  onClose: () => void;
  trips: GeneratedTrip[];
  onView: (t: GeneratedTrip) => void;
  onDelete: (id: string) => void;
  onBook: (t: GeneratedTrip) => void;
  onStatus: (id: string, s: GeneratedTrip["status"]) => void;
  onPlan: () => void;
}) {
  useModalLifecycle(open, onClose);
  if (!open) return null;

  return (
    <div className="fixed inset-0 z-[92] flex justify-end" role="dialog" aria-modal="true" aria-label="My saved trips">
      <div className="modal-backdrop absolute inset-0" onClick={onClose} />
      <aside className="drawer-right relative flex h-full w-full max-w-md flex-col bg-coal sm:border-l sm:border-ivory/12">
        <div className="flex items-center justify-between border-b border-ivory/10 px-6 py-5">
          <div>
            <p className="eyebrow text-champagne">Your travel file</p>
            <h3 className="mt-1 font-display text-[26px] font-semibold text-ivory">My Trips {trips.length > 0 && <span className="text-champagne tabular">({trips.length})</span>}</h3>
          </div>
          <button onClick={onClose} aria-label="Close my trips" className="btn-press flex h-10 w-10 items-center justify-center rounded-full border border-ivory/15 text-ivory/70 hover:border-champagne">
            <X size={18} />
          </button>
        </div>
        <div className="flex-1 overflow-y-auto p-4">
          {trips.length === 0 ? (
            <div className="flex h-full flex-col items-center justify-center px-8 text-center">
              <span className="flex h-16 w-16 items-center justify-center rounded-full border border-ivory/12 text-ivory/30">
                <MapPin size={24} />
              </span>
              <h4 className="mt-5 font-display text-[24px] font-medium text-ivory">No journeys saved yet.</h4>
              <p className="mt-2 text-[14px] leading-relaxed text-ivory/55">Generate an itinerary and it will be kept here — ready to view, edit or book.</p>
              <button onClick={onPlan} className="btn-press mt-6 inline-flex items-center gap-2 rounded-full bg-champagne px-6 py-3 text-[12.5px] font-extrabold uppercase tracking-[0.1em] text-ink hover:bg-champagnelight">
