                </Reveal>
                <div className="col-span-5 flex flex-col gap-5">
                  <Reveal delay={100}><DestinationCard id="skardu" variant="standard" isFav={favorites.has("skardu")} ping={heartPing === "skardu"} onFav={toggleFav} onOpen={setDetailId} onPlan={openPlanner} /></Reveal>
