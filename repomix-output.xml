/* Travel with Tariq — brand mark.
   Compass ring + mountain ridge + subtle "T" geometry. */

export function LogoMark({ size = 40, light = true }: { size?: number; light?: boolean }) {
  const ring = "#C9A86A";
  const ridge = light ? "#F5F1E8" : "#0B0E14";
  return (
    <svg
      width={size}
      height={size}
      viewBox="0 0 64 64"
      fill="none"
      role="img"
      aria-label="Travel with Tariq logo"
    >
      {/* compass ring */}
      <circle cx="32" cy="32" r="29" stroke={ring} strokeWidth="2.4" />
      <circle cx="32" cy="32" r="23.5" stroke={ring} strokeWidth="0.8" opacity="0.45" />
      {/* cardinal ticks */}
      <path d="M32 1.5v5M32 57.5v5M1.5 32h5M57.5 32h5" stroke={ring} strokeWidth="1.6" strokeLinecap="round" />
      {/* north needle */}
      <path d="M27.5 8.5h9L32 14.5l-4.5-6z" fill={ring} />
      {/* mountain ridge forming T crossbar + stem */}
      <path
        d="M13 41.5 23 27l6.5 8L36 25l6 9.5 4.5-5.5L53 41.5"
        stroke={ridge}
        strokeWidth="2.8"
        strokeLinecap="round"
        strokeLinejoin="round"
      />
      {/* T stem */}
      <path d="M32 30v11.5" stroke={ring} strokeWidth="2.6" strokeLinecap="round" />
      <circle cx="32" cy="32" r="1.6" fill={ring} />
    </svg>
  );
}

