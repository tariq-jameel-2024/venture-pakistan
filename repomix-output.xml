export function tripWhatsappMessage(t: {
  destination: string;
  duration: number;
  travelers: number;
  budget: string;
  travelStyle: string;
  costing?: { total: number };
}): string {
  return `Hello Tariq,\nI would like to plan a trip to ${t.destination}.\n\nTrip duration: ${t.duration} days\nTravelers: ${t.travelers}\nBudget tier: ${t.budget}\nTravel style: ${t.travelStyle}${t.costing ? `\nEstimated cost: ${formatPKR(t.costing.total)}` : ""}\n\nPlease help me finalize the itinerary and booking.`;
}

export function readJSON<T>(key: string, fallback: T): T {
  try {
    const raw = localStorage.getItem(key);
    if (!raw) return fallback;
    return JSON.parse(raw) as T;
  } catch {
    return fallback;
  }
}

export function writeJSON(key: string, value: unknown) {
  try {
    localStorage.setItem(key, JSON.stringify(value));
  } catch {
    /* storage unavailable */
  }
}
