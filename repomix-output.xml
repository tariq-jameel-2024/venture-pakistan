        onFavorites={() => setFavOpen(true)}
        onTalk={() => talkToTariq()}
      />

      {/* sticky mobile booking CTA */}
      <div className="fixed inset-x-4 bottom-[76px] z-[60] lg:hidden">
        <button onClick={() => openPlanner(explorerId)}
          className="btn-press flex w-full items-center justify-center gap-2 rounded-full bg-champagne py-3.5 text-[13px] font-extrabold uppercase tracking-[0.1em] text-ink shadow-[0_12px_32px_rgba(201,168,106,0.35)]">
          <Sparkles size={15} /> Plan my journey
        </button>
      </div>
    </div>
  );
}

/* ================================================================
   Destination cards — editorial variants
   ================================================================ */

function DestinationCard({
  id, variant, isFav, ping, onFav, onOpen, onPlan,
}: {
  id: string;
  variant: "feature" | "standard" | "wide" | "wideReverse" | "tall" | "mobile";
  isFav: boolean;
  ping: boolean;
  onFav: (id: string) => void;
  onOpen: (id: string) => void;
  onPlan: (id: string) => void;
}) {
  const d = getDestination(id);

  const favBtn = (
    <button
      onClick={(e) => { e.stopPropagation(); onFav(d.id); }}
      aria-label={isFav ? `Remove ${d.name} from favorites` : `Save ${d.name} to favorites`}
      className={`btn-press z-10 flex h-10 w-10 items-center justify-center rounded-full backdrop-blur-md ${
        isFav ? "bg-champagne text-ink" : "bg-ink/55 text-ivory hover:text-champagne"
      } ${ping ? "heart-pop" : ""}`}
    >
      <Heart size={17} className={isFav ? "fill-ink" : ""} />
    </button>
  );

  if (variant === "mobile") {
    return (
      <article className="w-[78vw] max-w-[320px] shrink-0 snap-start overflow-hidden rounded-xl border border-ivory/10 bg-coal">
        <div className="img-frame img-duotone relative h-44">
          <img src={d.image} alt={d.name} className="h-full w-full object-cover" loading="lazy" />
          <div className="absolute right-3 top-3">{favBtn}</div>
          <span className="absolute left-3 top-3 rounded-full bg-ink/65 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-[0.16em] text-champagne backdrop-blur-md">{d.region}</span>
        </div>
        <div className="p-4">
          <div className="flex items-start justify-between gap-2">
            <h3 className="font-display text-[22px] font-semibold leading-tight">{d.name}</h3>
            <Stars rating={d.rating} />
          </div>
          <p className="mt-1 line-clamp-2 text-[13px] leading-relaxed text-ivory/60">{d.description}</p>
          <div className="mt-3 flex items-center justify-between">
            <p className="text-[12px] text-ivory/50">From <span className="font-display text-[19px] font-semibold text-champagne tabular">{formatPKR(d.startingPrice)}</span></p>
            <span className="text-[12px] font-bold text-ivory/50">{d.duration}</span>
          </div>
          <button onClick={() => onOpen(d.id)} className="btn-press mt-3 w-full rounded-full bg-ivory py-3 text-[12px] font-extrabold uppercase tracking-[0.1em] text-ink">
            Explore
          </button>
        </div>
      </article>
    );
  }

  if (variant === "feature") {
    return (
      <article className="group relative h-[540px] cursor-pointer overflow-hidden rounded-xl border border-ivory/10" onClick={() => onOpen(d.id)}>
        <img src={d.image} alt={d.name} className="absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] group-hover:scale-105" loading="lazy" />
        <div className="absolute inset-0 bg-gradient-to-t from-ink via-ink/25 to-transparent" />
        <div className="absolute left-5 top-5 flex items-center gap-2">
          <span className="rounded-full bg-champagne px-3 py-1.5 text-[10.5px] font-extrabold uppercase tracking-[0.16em] text-ink">No. 01 — Most loved</span>
        </div>
        <div className="absolute right-5 top-5" onClick={(e) => e.stopPropagation()}>{favBtn}</div>
        <div className="absolute inset-x-0 bottom-0 p-6 md:p-8">
          <p className="text-[11px] font-bold uppercase tracking-[0.3em] text-champagne">{d.region}</p>
          <h3 className="mt-2 font-display text-[44px] font-medium leading-none">{d.name}</h3>
          <p className="mt-3 max-w-md text-[14.5px] leading-relaxed text-ivory/75">{d.description}</p>
          <div className="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px] font-semibold text-ivory/70">
            <Stars rating={d.rating} />
            <span className="inline-flex items-center gap-1.5"><Clock size={13} /> {d.duration}</span>
            <span>From <b className="font-display text-[20px] text-champagne tabular">{formatPKR(d.startingPrice)}</b></span>
          </div>
          <div className="mt-5 flex gap-3">
            <span className="btn-press inline-flex items-center gap-2 rounded-full bg-ivory px-6 py-3 text-[12.5px] font-extrabold uppercase tracking-[0.1em] text-ink group-hover:bg-champagne">
              Explore journey <ArrowUpRight size={15} />
            </span>
            <button onClick={(e) => { e.stopPropagation(); onPlan(d.id); }}
              className="btn-press rounded-full border border-ivory/30 px-6 py-3 text-[12.5px] font-extrabold uppercase tracking-[0.1em] text-ivory backdrop-blur-sm hover:border-champagne">
              Plan this trip
            </button>
          </div>
        </div>
      </article>
    );
  }

  if (variant === "standard") {
    return (
      <article className="group grid cursor-pointer grid-cols-[150px_1fr] overflow-hidden rounded-xl border border-ivory/10 bg-coal transition-colors hover:border-champagne/35" onClick={() => onOpen(d.id)}>
        <div className="img-frame relative min-h-[190px]">
          <img src={d.image} alt={d.name} className="absolute inset-0 h-full w-full object-cover" loading="lazy" />
        </div>
        <div className="relative p-5">
          <div className="absolute right-4 top-4" onClick={(e) => e.stopPropagation()}>{favBtn}</div>
          <p className="text-[10px] font-bold uppercase tracking-[0.26em] text-champagne">{d.region}</p>
          <h3 className="mt-1 font-display text-[26px] font-semibold leading-tight">{d.name}</h3>
          <p className="mt-1.5 line-clamp-2 text-[13px] leading-relaxed text-ivory/60">{d.description}</p>
          <div className="mt-3 flex items-center justify-between">
            <p className="text-[12px] text-ivory/50">From <span className="font-display text-[19px] font-semibold text-champagne tabular">{formatPKR(d.startingPrice)}</span></p>
            <span className="inline-flex items-center gap-1 text-[12px] font-extrabold uppercase tracking-[0.08em] text-ivory/60 group-hover:text-champagne">
              Explore <ArrowRight size={13} />
            </span>
          </div>
        </div>
      </article>
    );
  }

  if (variant === "wide" || variant === "wideReverse") {
    const reverse = variant === "wideReverse";
    return (
      <article
        className={`group grid cursor-pointer overflow-hidden rounded-xl border border-ivory/10 bg-coal transition-colors hover:border-champagne/35 md:grid-cols-2`}
        onClick={() => onOpen(d.id)}
      >
        <div className={`img-frame relative min-h-[260px] md:min-h-[300px] ${reverse ? "md:order-2" : ""}`}>
          <img src={d.image} alt={d.name} className="absolute inset-0 h-full w-full object-cover" loading="lazy" />
          <span className="absolute left-5 top-5 rounded-full bg-ink/65 px-3 py-1.5 text-[10.5px] font-extrabold uppercase tracking-[0.18em] text-champagne backdrop-blur-md">
            {reverse ? "Coastal escape" : "Cultural icon"}
          </span>
        </div>
        <div className={`relative flex flex-col justify-center p-6 md:p-10 ${reverse ? "md:order-1" : ""}`}>
          <div className="absolute right-5 top-5" onClick={(e) => e.stopPropagation()}>{favBtn}</div>
          <p className="text-[11px] font-bold uppercase tracking-[0.3em] text-champagne">{d.region} · {d.altitude}</p>
          <h3 className="mt-2 font-display text-[38px] font-medium leading-none">{d.name}</h3>
          <p className="mt-3 max-w-md text-[14.5px] leading-relaxed text-ivory/65">{d.description}</p>
          <div className="mt-4 flex flex-wrap gap-1.5">
            {d.highlights.slice(0, 4).map((h) => (
              <span key={h} className="rounded-full border border-ivory/12 px-2.5 py-1 text-[11.5px] font-bold text-ivory/60">{h}</span>
            ))}
          </div>
          <div className="mt-5 flex items-center gap-5">
            <Stars rating={d.rating} />
            <span className="text-[13px] font-semibold text-ivory/60">{d.duration} · {d.bestSeason}</span>
          </div>
          <div className="mt-5 flex items-center gap-4">
            <p className="text-[12px] text-ivory/50">From <span className="font-display text-[24px] font-semibold text-champagne tabular">{formatPKR(d.startingPrice)}</span></p>
            <button onClick={(e) => { e.stopPropagation(); onPlan(d.id); }}
              className="btn-press ml-auto inline-flex items-center gap-2 rounded-full bg-ivory px-6 py-3 text-[12px] font-extrabold uppercase tracking-[0.1em] text-ink hover:bg-champagne">
              Plan this trip <ArrowRight size={14} />
            </button>
          </div>
        </div>
      </article>
    );
  }

  // tall
  return (
    <article className="group flex h-full cursor-pointer flex-col overflow-hidden rounded-xl border border-ivory/10 bg-coal transition-colors hover:border-champagne/35" onClick={() => onOpen(d.id)}>
      <div className="img-frame img-duotone relative h-64">
        <img src={d.image} alt={d.name} className="h-full w-full object-cover" loading="lazy" />
        <span className="absolute left-4 top-4 rounded-full bg-ink/65 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-[0.16em] text-champagne backdrop-blur-md">{d.region}</span>
        <div className="absolute right-4 top-4" onClick={(e) => e.stopPropagation()}>{favBtn}</div>
        <div className="absolute bottom-3 left-4 z-10"><Stars rating={d.rating} /></div>
      </div>
      <div className="flex flex-1 flex-col p-5">
        <h3 className="font-display text-[27px] font-semibold leading-tight">{d.name}</h3>
        <p className="mt-1.5 flex-1 text-[13.5px] leading-relaxed text-ivory/60">{d.description}</p>
        <div className="mt-4 flex items-center justify-between border-t border-ivory/10 pt-3.5">
          <p className="text-[12px] text-ivory/50">From <span className="font-display text-[20px] font-semibold text-champagne tabular">{formatPKR(d.startingPrice)}</span></p>
          <span className="text-[12px] font-bold text-ivory/50">{d.duration}</span>
        </div>
        <button onClick={(e) => { e.stopPropagation(); onPlan(d.id); }}
          className="btn-press mt-3 w-full rounded-full border border-ivory/20 py-3 text-[12px] font-extrabold uppercase tracking-[0.1em] text-ivory hover:border-champagne hover:text-champagne">
          Plan this trip
        </button>
      </div>
    </article>
  );
}
