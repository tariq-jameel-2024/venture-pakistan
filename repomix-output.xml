  useEffect(() => {
    const onScroll = () => setScrolled(window.scrollY > 40);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    return () => window.removeEventListener("scroll", onScroll);
  }, []);

  const [toasts, setToasts] = useState<ToastItem[]>([]);
  const toast = useCallback((message: string, kind: ToastItem["kind"] = "success") => {
    const id = Date.now() + Math.random();
    setToasts((p) => [...p.slice(-2), { id, message, kind }]);
    setTimeout(() => setToasts((p) => p.filter((t) => t.id !== id)), 3200);
  }, []);

  /* ---------- persisted state ---------- */
  const [favorites, setFavorites] = useState<Set<string>>(
    () => new Set(readJSON<string[]>(STORAGE_KEYS.favorites, []))
  );
  const [trips, setTrips] = useState<GeneratedTrip[]>(() => readJSON(STORAGE_KEYS.trips, []));

  useEffect(() => writeJSON(STORAGE_KEYS.favorites, [...favorites]), [favorites]);
  useEffect(() => writeJSON(STORAGE_KEYS.trips, trips), [trips]);

  /* ---------- modal state ---------- */
  const [searchOpen, setSearchOpen] = useState(false);
  const [favOpen, setFavOpen] = useState(false);
  const [tripsOpen, setTripsOpen] = useState(false);
  const [plannerOpen, setPlannerOpen] = useState(false);
  const [profileOpen, setProfileOpen] = useState(false);
  const [detailId, setDetailId] = useState<string | null>(null);
  const [activeTrip, setActiveTrip] = useState<GeneratedTrip | null>(null);
  const [itineraryOpen, setItineraryOpen] = useState(false);
  const [explorerId, setExplorerId] = useState("hunza");
  const [plannerPreset, setPlannerPreset] = useState("hunza");
  const [heartPing, setHeartPing] = useState<string | null>(null);

  /* ---------- actions ---------- */
  const toggleFav = useCallback((id: string) => {
    setFavorites((prev) => {
      const next = new Set(prev);
      const d = getDestination(id);
      if (next.has(id)) {
        next.delete(id);
        toast(`${d.shortName} removed from favorites.`, "info");
      } else {
        next.add(id);
        toast(`${d.shortName} added to your favorites.`);
      }
      setHeartPing(id);
      setTimeout(() => setHeartPing(null), 450);
      return next;
    });
  }, [toast]);

  const [plannerDefaults, setPlannerDefaults] = useState<{
    days: number; travelers: number; budget: PlannerInput["budget"];
  }>({ days: 5, travelers: 2, budget: "Comfort" });

  const openPlanner = useCallback((
    destinationId = "hunza",
    overrides?: { days?: number; travelers?: number; budget?: PlannerInput["budget"] }
  ) => {
    setPlannerPreset(destinationId);
    if (overrides) {
      setPlannerDefaults((prev) => ({
        days: Math.min(14, Math.max(1, overrides.days ?? prev.days)),
        travelers: Math.min(12, Math.max(1, overrides.travelers ?? prev.travelers)),
        budget: overrides.budget ?? prev.budget,
      }));
    }
    setDetailId(null);
    setFavOpen(false);
    setTripsOpen(false);
    setPlannerOpen(true);
  }, []);

  const handleGenerated = useCallback((trip: GeneratedTrip) => {
    setPlannerOpen(false);
    setActiveTrip(trip);
    setItineraryOpen(true);
    toast("Your itinerary is ready.");
  }, [toast]);

  const saveTrip = useCallback((trip: GeneratedTrip) => {
    setTrips((prev) => {
      if (prev.some((t) => t.id === trip.id)) return prev;
      return [trip, ...prev];
    });
    toast("Journey saved successfully.");
  }, [toast]);

  const isTripSaved = useMemo(
    () => (activeTrip ? trips.some((t) => t.id === activeTrip.id) : false),
    [trips, activeTrip]
  );

  const deleteTrip = useCallback((id: string) => {
    setTrips((prev) => prev.filter((t) => t.id !== id));
    toast("Trip removed.", "info");
  }, [toast]);

  const updateStatus = useCallback((id: string, status: GeneratedTrip["status"]) => {
    setTrips((prev) => prev.map((t) => (t.id === id ? { ...t, status } : t)));
    toast(`Trip marked as “${status}”.`, "info");
  }, [toast]);

  const bookTrip = useCallback((t: GeneratedTrip) => {
    window.open(whatsappLink(tripWhatsappMessage(t)), "_blank", "noopener");
    toast("Opening WhatsApp to confirm your booking…", "info");
  }, [toast]);

  const talkToTariq = useCallback((destination?: string) => {
    const msg = destination
      ? `Hello Tariq,\nI would like to plan a trip to ${destination}.\nPlease share options and availability.`
      : `Hello Tariq,\nI found Travel with Tariq and would like help planning a journey across Pakistan.`;
    window.open(whatsappLink(msg), "_blank", "noopener");
  }, []);

  const scrollTo = (id: string) => document.getElementById(id)?.scrollIntoView({ behavior: "smooth" });

  /* ---------- quick planner (hero) ---------- */
  const [qp, setQp] = useState({ dest: "hunza", date: "", duration: "5", travelers: "2", budget: "Comfort" });

  /* ---------- newsletter ---------- */
  const [email, setEmail] = useState("");
  const subscribe = (e: React.FormEvent) => {
    e.preventDefault();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      toast("Please enter a valid email address.", "warn");
      return;
    }
    setEmail("");
    toast("Subscribed — destination inspiration is on its way.");
  };

  /* ---------- signature journey: canonical hunza trip ---------- */
  const signatureTrip = useMemo(
    () => generateItinerary({
      destinationId: "hunza", days: 5, travelers: 2,
      budget: "Premium", travelStyle: "Culture", pace: "Balanced",
      interests: ["Mountains", "History", "Photography"],
    }),
    []
